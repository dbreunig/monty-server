# Required for local dev. Copy to `.env` and fill in.

# Where the server stores SQLite + env snapshots + uploaded files.
DATA_DIR=./data

# Public base URL the server is reachable at. GitHub's OAuth callback must
# be configured as `${BASE_URL}/auth/callback`.
BASE_URL=http://localhost:3000

# GitHub OAuth App credentials.
# Create one at https://github.com/settings/developers → New OAuth App.
#  - Homepage URL:              http://localhost:3000
#  - Authorization callback URL: http://localhost:3000/auth/callback
# If empty strings, the "Sign in with GitHub" button is hidden; email/password
# login still works.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Admin bootstrap. When both are set, the server seeds a local admin user on
# startup and auto-approves them. The admin can then approve new sign-ups from
# the /admin panel. Leave unset for a GitHub-only deployment.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Random secret used to sign session cookies. Must be >= 64 bytes.
# Generate with: `openssl rand -hex 32`
SESSION_SECRET=

# Sandbox workers. Code runs in `monty` subprocesses from the `monty-runtime`
# crate, which must match the monty-pool version in Cargo.toml:
#   cargo install monty-runtime --version 1.5.0 --no-default-features --locked
# The server looks for MONTY_WORKER_BIN, then `monty` next to its own binary,
# then `monty` on PATH.
# MONTY_WORKER_BIN=
# Workers kept warm / max concurrent executions. Each worker may use up to
# 128 MB of heap, so size MONTY_MAX_WORKERS to your RAM.
# MONTY_MIN_WORKERS=1
# MONTY_MAX_WORKERS=3

# Optional.
RUST_LOG=info
# HOST=0.0.0.0
# PORT=3000
